@page "/"
@rendermode InteractiveServer
@inject LocalMythGuide.Services.MythService MythService
@inject NavigationManager NavigationManager

<PageTitle>Discovery Board</PageTitle>

<div class="container pb-5">
    <!-- Hero Section -->
    <div class="text-center py-5 mb-2 mt-3">
        <span class="badge mb-3" style="background-color: rgba(248, 196, 113, 0.1); color: #f8c471; border: 1px solid rgba(248, 196, 113, 0.3); padding: 8px 16px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase;">
            Interactive Guide
        </span>
        <h1 class="display-4 fw-bold mb-3 text-glow">Whispers of the Land</h1>
        <p class="lead mx-auto" style="max-width: 650px; color: #a0aec0; line-height: 1.8;">
            Uncover the untold folklore, ancient spirits, and local myths hidden behind familiar landmarks. Select a destination below to reveal the legend it holds.
        </p>
    </div>

    <!-- Discovery Grid -->
    <div class="card-grid">
        @foreach (var myth in myths)
        {
            <div class="flip-card" @onclick="() => ToggleCard(myth.Id)">
                <div class="flip-card-inner @(FlippedCards.Contains(myth.Id) ? "flipped" : "")">
                    <!-- Front of Card -->
                    <div class="flip-card-front" style="background-image: linear-gradient(rgba(18, 22, 25, 0.4), rgba(18, 22, 25, 0.9)), url('@myth.ImageUrl'); background-size: cover; background-position: center;">
                        <h3 class="text-shadow">@myth.Title</h3>
                        <p class="location-tag">📍 @myth.Location</p>
                    </div>
                    <!-- Back of Card -->
                    <div class="flip-card-back">
                        <p class="px-3" style="font-size: 1.05rem; line-height: 1.6;">@myth.ShortSummary</p>
                        <button class="btn btn-primary mt-3" @onclick="() => GoToDetails(myth.Id)" @onclick:stopPropagation="true">
                            Read Full Story
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // Keep your existing C# code here!
    private List<LocalMythGuide.Models.Myth> myths = new();
    private HashSet<int> FlippedCards = new();

    protected override void OnInitialized()
    {
        myths = MythService.GetMyths();
    }

    private void ToggleCard(int id)
    {
        if (FlippedCards.Contains(id))
            FlippedCards.Remove(id);
        else
            FlippedCards.Add(id);
    }

    private void GoToDetails(int id)
    {
        NavigationManager.NavigateTo($"/story/{id}");
    }
}