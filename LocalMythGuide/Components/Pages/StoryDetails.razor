@page "/story/{Id:int}"
@rendermode InteractiveServer
@inject LocalMythGuide.Services.MythService MythService
@inject NavigationManager NavigationManager

<PageTitle>Story Details</PageTitle>

<div class="container mt-4" style="max-width: 800px;">
    @if (myth == null)
    {
        <div class="text-center mt-5">
            <h3 class="text-muted">The mists obscure this legend... (Story not found)</h3>
        </div>
    }
    else
    {
       <button class="btn btn-outline-light mb-4" @onclick="GoBack">← Return to the Board</button>
        
        <!-- Hero Banner Added Here -->
        <div class="mb-4 text-center">
            <img src="@myth.ImageUrl" class="img-fluid rounded shadow-lg" style="width: 100%; max-height: 400px; object-fit: cover; border: 1px solid #2a343c;" alt="@myth.Title" />
        </div>
        
        <div class="text-center mb-5">
            <h1 class="display-4">@myth.Title</h1>
            <h5 style="color: #a0aec0; letter-spacing: 2px; text-transform: uppercase;">
                📍 @myth.Location
            </h5>
        </div>
        
        <hr style="border-color: #f8c471; opacity: 0.3;" />
        
        <div class="mt-5 mb-5" style="font-size: 1.15rem; line-height: 1.8;">
            <p>@myth.FullStory</p>
        </div>

        <div class="card bg-dark text-light border-warning mt-5">
            <div class="card-body">
                <h5 class="card-title text-warning">🎒 Traveler's Insight</h5>
                <p class="card-text">@myth.PracticalInfo</p>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private LocalMythGuide.Models.Myth? myth;

    protected override void OnInitialized()
    {
        myth = MythService.GetMythById(Id);
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }
}