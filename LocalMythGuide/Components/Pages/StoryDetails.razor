@page "/story/{Id:int}"
@rendermode InteractiveServer
@inject LocalMythGuide.Services.MythService MythService
@inject NavigationManager NavigationManager

@if (myth == null)
{
    <p>Story not found!</p>
}
else
{
    <button class="btn btn-secondary mb-3" @onclick="GoBack">← Back to Board</button>
    <h2>@myth.Title</h2>
    <h5 class="text-muted">📍 @myth.Location</h5>

    <hr />
    <h4>The Legend</h4>
    <p>@myth.FullStory</p>

    <div class="alert alert-info mt-4">
        <strong>Practical Info for Travelers:</strong> <br />
        @myth.PracticalInfo
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private LocalMythGuide.Models.Myth? myth;

    protected override void OnInitialized()
    {
        myth = MythService.GetMythById(Id);
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }
}